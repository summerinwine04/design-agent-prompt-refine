{
  "schema_version": "1.0",
  "schema_name": "童装牛仔类目 Placement Schema",
  "description": "按品类 x 档位枚举可用 placement 位置，供 Step 2 改款设计 agent 消费",
  "last_updated": "2026-05-19",
  "applies_to": "Step 2 改款设计的锚点选择（每个色号方案）",
  "tier_size_limits": {
    "A": {
      "name_zh": "超大主图",
      "name_en": "super statement print",
      "max_edge_cm": 20,
      "max_area_sq_cm": 400,
      "max_face_coverage_pct": 50,
      "scarcity": "单款多色中最多 1 个色号方案可使用，9 色场景 A ≤ 1",
      "use_cases": [
        "纪念款",
        "节庆款",
        "IP 联名款",
        "非日常款"
      ],
      "default": false,
      "note": "若使用 A 档，必须填写 A档使用理由"
    },
    "B": {
      "name_zh": "主图",
      "name_en": "statement print",
      "max_edge_cm": 12,
      "max_area_sq_cm": 100,
      "max_face_coverage_pct": 30,
      "scarcity": "日常款默认主图档位",
      "use_cases": [
        "徽章",
        "适中主图案",
        "Logo 标识"
      ],
      "default": true
    },
    "C": {
      "name_zh": "副图",
      "name_en": "accent print",
      "max_edge_cm": 7,
      "max_area_sq_cm": 100,
      "max_face_coverage_pct": null,
      "use_cases": [
        "小图案",
        "口袋印花",
        "辅助元素"
      ],
      "default": true,
      "note": "数学上 7cm 最长边对应面积上限 49 sq cm，schema 给出宽松值 100 sq cm 作为参考极限"
    },
    "D": {
      "name_zh": "装饰",
      "name_en": "trim / pattern band",
      "max_edge_cm": null,
      "max_unit_height_cm": 3,
      "max_area_sq_cm": null,
      "max_face_coverage_pct": null,
      "use_cases": [
        "装饰带",
        "连续 pattern",
        "小 logo 重复",
        "边缘点缀"
      ],
      "default": true,
      "note": "单元高度 ≤ 3cm，可沿边缘重复排列"
    }
  },
  "exclusion_rules": [
    "A 档与 B 档互斥：同方案禁止同时使用 A 和 B（视觉重量过载）",
    "禁止单方案同时使用 2 个 A、2 个 B",
    "禁止任何锚点跨越版型分割线（口袋边、缝线、拉链、纽扣）",
    "禁止任何锚点覆盖五金（铆钉、纽扣、拉链头、皮标）",
    "C 档建议数量 0~3 个，D 档建议数量 0~2 个，但 D 档可沿同一条边缘重复排列"
  ],
