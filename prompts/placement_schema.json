  "usage_for_agent": {
    "selection_workflow": [
      "1. 根据 款号 / 款式名 判断 category（denim_jacket / denim_tshirt / denim_jeans / denim_shirt）",
      "2. 对该 category 下的 placements，按 tier（A/B/C/D）和 face（front/back/side）筛选",
      "3. 在选定 cell（face x tier）下的 placement 列表中按 popularity 排序优先选",
      "4. 每个锚点的 size_hint 作为初始尺寸建议，最终尺寸不得超过 tier_size_limits 中对应档的上限",
      "5. 跨面组合需 ≥ 2 个锚点且 face 互不相同；三面组合需 3 个锚点 face 各异"
    ],
    "selection_constraints": [
      "整方案最多 1 个 A 或 1 个 B（互斥）",
      "整方案 0~3 个 C，0~2 个 D",
      "9 色场景全集中 A 档方案 ≤ 1",
      "全集中任一具体 placement.id 出现次数 ≤ 总色号数的 1/3",
      "全集中每个 face（front/back/side）至少在 1/3 总色号数的方案中出现",
      "跨面组合占比 ≥ 2/3，单面方案占比 ≤ 1/3"
    ]
  },
